# Copy to .env.local for local work; on Vercel add the same names under Settings > Environment Variables.

# Contact form email (Resend)
RESEND_API_KEY=

# Shared by the contact form's rate limiter AND the guestbook wall (Upstash Redis, REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "Now playing" line in the footer (Spotify). Leave blank and the line simply stays hidden.
# 1. Create an app at https://developer.spotify.com/dashboard (redirect URI: http://127.0.0.1:3000/callback)
# 2. Authorize it once with the scopes: user-read-currently-playing user-read-recently-played
# 3. Paste the client id, client secret and the refresh token you get back.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Lock wall admin page (/admin/locks): the password you type there to approve locks and set the gold lock.
# Pick a long random string. Needs the Upstash variables above too.
GUESTBOOK_ADMIN_TOKEN=
